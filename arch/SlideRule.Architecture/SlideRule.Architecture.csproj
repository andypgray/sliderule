<Project Sdk="Microsoft.NET.Sdk">

    <!-- This repo's own architecture spec — the dogfood render source. It references Core (the reified
         model every spec builds against) and takes the Microsoft.Build.Locator package for the typeof that
         roslyn/no-msbuildlocator-query names. It also takes the DotNetGuidance rule pack, which is where two
         of its DI rules come from. Loaded by the CLI via the spec flag (convention resolution is ambiguous
         here because the test fixtures also reference Core). Its rendered block lives in the committed root
         AGENTS.md, kept current by the self-spec tests. IsPackable=false: it ships with nothing.

         CopyLocalLockFileAssemblies is required: the CLI loads this spec into an AssemblyLoadContext
         whose AssemblyDependencyResolver is rooted at the built spec DLL, so the Locator and the pack's own
         package dependencies (the two Microsoft.Extensions.DependencyInjection assemblies) have to sit
         beside it. Without this they would resolve at build time and be missing at check time. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SlideRule\SlideRule.csproj" />
        <ProjectReference Include="..\..\src\SlideRule.Packs.DotNet\SlideRule.Packs.DotNet.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    </ItemGroup>

</Project>
