<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Meridian.Domain\Meridian.Domain.csproj" />
        <ProjectReference Include="..\Meridian.Clearance\Meridian.Clearance.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
        <!-- SqlClient 7.0.2 depends on Pkcs 9.0.13 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). Drop this once SqlClient takes 9.0.21 or later. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    </ItemGroup>

</Project>
