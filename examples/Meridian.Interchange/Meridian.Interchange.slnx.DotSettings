<wpf:ResourceDictionary xml:space="preserve" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:ss="urn:shemas-jetbrains-com:settings-storage-xaml" xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
	<!-- Each example is a solution of its own, and ReSharper mounts only the settings file sitting
	     beside the solution it opened. There is no directory layer between them, so nothing here
	     inherits from the repository's own SlideRule.slnx.DotSettings. Without this file the
	     style of an example tree is whatever the machine running cleanup happens to declare, which is
	     a policy this repository does not carry and cannot reproduce.

	     So the four example solutions each hold a copy of the entries below, and that root file is the
	     authority for why each of them exists. What an example does not copy is the rest of it:
	     promotions that answer questions only a solution shipping public packages contains, and
	     promotions whose sites have not been cleared here, which would declare a line these trees do
	     not yet hold.

	     Contributors need not run ReSharper; the file is simply ignored by anything that doesn't. -->

	<!-- Named arguments are a deliberate prose-parameter documentation convention (GRAMMAR §10:
	     from:, to:, description:), and the spec in this example is written in it. Protecting them
	     takes two settings, because inspect and cleanup read different axes and do not share a
	     switch: these five severities stop a deliberate name being REPORTED as removable, and the
	     cleanup profile below stops it being REWRITTEN. -->
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=ArgumentsStyleLiteral/@EntryIndexedValue">DO_NOT_SHOW</s:String>
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=ArgumentsStyleStringLiteral/@EntryIndexedValue">DO_NOT_SHOW</s:String>
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=ArgumentsStyleNamedExpression/@EntryIndexedValue">DO_NOT_SHOW</s:String>
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=ArgumentsStyleOther/@EntryIndexedValue">DO_NOT_SHOW</s:String>
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=ArgumentsStyleAnonymousFunction/@EntryIndexedValue">DO_NOT_SHOW</s:String>

	<!-- The cleanup profile, copied verbatim from the root settings file, which is where the shape of
	     a profile blob is explained and each of its three False tasks given its reason. The one that
	     earns its keep here is ArrangeArgumentsStyle: False is the only value that leaves the named
	     arguments above as authored, because the style setting itself is binary with no "leave alone".

	     Its arrival is what retires the standing exception that kept cleanup away from the example
	     spec file. With this profile in place, any file in this example can be passed to cleanup. -->
	<s:String x:Key="/Default/CodeStyle/CodeCleanup/Profiles/=SlideRule_003A_0020Full_0020Cleanup_0020_0028keep_0020named_0020arguments_0029/@EntryIndexedValue">&lt;?xml version="1.0" encoding="utf-16"?&gt;&lt;Profile name="SlideRule: Full Cleanup (keep named arguments)"&gt;&lt;CSReformatCode&gt;True&lt;/CSReformatCode&gt;&lt;CSharpFormatDocComments&gt;True&lt;/CSharpFormatDocComments&gt;&lt;CSharpReformatComments&gt;True&lt;/CSharpReformatComments&gt;&lt;CSOptimizeUsings&gt;&lt;OptimizeUsings&gt;True&lt;/OptimizeUsings&gt;&lt;EmbraceInRegion&gt;False&lt;/EmbraceInRegion&gt;&lt;RegionName&gt;&lt;/RegionName&gt;&lt;/CSOptimizeUsings&gt;&lt;CSShortenReferences&gt;True&lt;/CSShortenReferences&gt;&lt;CSReorderTypeMembers&gt;False&lt;/CSReorderTypeMembers&gt;&lt;CSUpdateFileHeader&gt;False&lt;/CSUpdateFileHeader&gt;&lt;RemoveCodeRedundancies&gt;True&lt;/RemoveCodeRedundancies&gt;&lt;CSUseAutoProperty&gt;True&lt;/CSUseAutoProperty&gt;&lt;CSMakeFieldReadonly&gt;True&lt;/CSMakeFieldReadonly&gt;&lt;CSMakeAutoPropertyGetOnly&gt;True&lt;/CSMakeAutoPropertyGetOnly&gt;&lt;CSArrangeQualifiers&gt;True&lt;/CSArrangeQualifiers&gt;&lt;CSFixBuiltinTypeReferences&gt;True&lt;/CSFixBuiltinTypeReferences&gt;&lt;CSCodeStyleAttributes ArrangeVarStyle="True" ArrangeTypeAccessModifier="True" ArrangeTypeMemberAccessModifier="True" SortModifiers="True" ArrangeAccessors="True" ArrangeArgumentsStyle="False" RemoveRedundantParentheses="True" AddMissingParentheses="True" ArrangeBraces="True" ArrangeAttributes="True" ArrangeCodeBodyStyle="True" ArrangeTrailingCommas="True" ArrangeObjectCreation="True" ArrangeDefaultValue="True" ArrangeEmptyString="True" ArrangeNamespaces="True" ArrangeNullCheckingPattern="True" /&gt;&lt;/Profile&gt;</s:String>

	<!-- ReSharper's "profile to use when nobody picks one".

	     A runner that honours this key reads it before cleaning, so a cleanup call naming no profile
	     still gets the profile above and the deliberate named arguments survive. Omitting the profile
	     argument is the intended path; naming it is merely harmless. -->
	<s:String x:Key="/Default/CodeStyle/CodeCleanup/SilentCleanupProfile/@EntryValue">SlideRule: Full Cleanup (keep named arguments)</s:String>

	<!-- 'var' only where the initializer makes the type evident; explicit type everywhere else.

	     One policy, three category keys, all pinned to the same value, and the same value the root
	     settings file carries: what a reader learns from an example and what they would meet in the
	     product are one style rather than two. Two of the three otherwise ride in from a machine's
	     personal global layer, which ReSharper reads beneath this file; the third, ForOtherTypes,
	     stands at a factory default of always-var, which is what keeps var on a generic-returning
	     call where nothing on the line names the type. Cleanup enforces all three through the
	     profile's ArrangeVarStyle task, in both directions, on every file it touches. -->
	<s:String x:Key="/Default/CodeStyle/CSharpVarKeywordUsage/ForBuiltInTypes/@EntryValue">UseVarWhenEvident</s:String>
	<s:String x:Key="/Default/CodeStyle/CSharpVarKeywordUsage/ForSimpleTypes/@EntryValue">UseVarWhenEvident</s:String>
	<s:String x:Key="/Default/CodeStyle/CSharpVarKeywordUsage/ForOtherTypes/@EntryValue">UseVarWhenEvident</s:String>

	<!-- The severities that make the policy above enforceable rather than merely declared.

	     The three style entries say what the style IS; on their own they take effect only when
	     someone runs cleanup. These four say a departure is visible without one. Suggestion, the
	     default here, sits below the level anything reading a baseline looks at, so a drifted
	     declaration would wait unreported until the next cleanup of its file converted it inside an
	     unrelated diff.

	     Example code is read by newcomers, which makes explicit-where-not-evident a teaching default
	     as well as a house one: a sample names the type at every site whose initializer does not.

	     Inspect-only, like the DO_NOT_SHOW entries at the top of this file and for the same reason:
	     cleanup overrides the severity of every rule its enabled modules need, so nothing set here
	     reaches ArrangeVarStyle in either direction.

	     The _005F in each key is the escape for the underscore in the rule id, and it is the whole
	     entry: an underscore is how this format introduces an escape, so it cannot also stand for
	     itself. Spelled literally the key is one ReSharper never reads, and nothing anywhere says so
	     — the entry parses, the file loads, the rule keeps its default of hint, and a drifted
	     declaration stays below every severity a baseline is read at. Measured here before these
	     four were written this way: with the literal spelling the rule stayed at hint even when the
	     value was raised to ERROR, while a control rule promoted from hint in the same file moved. -->
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=SuggestVarOrType_005FBuiltInTypes/@EntryIndexedValue">WARNING</s:String>
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=SuggestVarOrType_005FSimpleTypes/@EntryIndexedValue">WARNING</s:String>
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=SuggestVarOrType_005FElsewhere/@EntryIndexedValue">WARNING</s:String>
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=SuggestVarOrType_005FDeconstructionDeclarations/@EntryIndexedValue">WARNING</s:String>

	<!-- Two unread-member rules held at Suggestion. That is a demotion: both default to Warning.

	     Every site they report across the four example trees is a positional record property or a
	     get-only accessor that solution-wide search finds nothing reading, and every one of them is
	     read all the same. The views, responses, confirmations and validation results are what an
	     endpoint returns, and the JSON serializer reads each property by reflection; the milestone
	     events are what one module publishes for a bus outside the tree to carry; the rate card and
	     the day-by-day charge breakdown carry the shape of the domain, which is the thing the
	     example teaches. None of those readers is a call the search can see, so the finding is
	     decided by evidence the solution does not contain, and the honest answer is a demotion with
	     its reason attached. Deleting the members instead would make the model a lie.

	     The reason is the examples' own and not the root file's. The root holds its usage rules at
	     Suggestion because a solution shipping public packages cannot answer them from inside; these
	     trees are unpackable, so that question is never asked here, and neither of these entries is
	     copied from the root or belongs in it, since its tree has no such site. The _002E in each
	     key is the escape for the dot in the rule id; spelled literally the key is one ReSharper
	     never reads, and nothing anywhere says so. -->
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=NotAccessedPositionalProperty_002EGlobal/@EntryIndexedValue">SUGGESTION</s:String>
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=UnusedAutoPropertyAccessor_002EGlobal/@EntryIndexedValue">SUGGESTION</s:String>

	<!-- Line wrapping is deliberately OFF, and this key is what pins it.

	     The spec in this example is a chain of English sentences, shaped by hand: the statement head
	     and each stage call sit one per line, and the subject and verb inside a clause stay inline
	     while the line fits. Wrapping on is ReSharper's default, and it fully chops any chain that
	     already carries one break — so deleting this entry looks like removing a restriction and is
	     really the opposite. No chain-wrapping key may stand beside it, for the same reason from the
	     other side. The formatter's standing job here is to preserve the shape, never to compute
	     it. -->
	<s:Boolean x:Key="/Default/CodeStyle/CodeFormatting/CSharpFormat/WRAP_LINES/@EntryValue">False</s:Boolean>

	<!-- ReSharper's own ledger of settings migrations, copied from the root file. A run over a
	     solution whose file lacks these entries writes them in, which is what once put one example's
	     file out of step with its three siblings; carried here, they are a no-op on every run. -->
	<s:Boolean x:Key="/Default/Environment/SettingsMigration/IsMigratorApplied/=JetBrains_002EReSharper_002EPsi_002ECSharp_002ECodeStyle_002ECSharpKeepExistingMigration/@EntryIndexedValue">True</s:Boolean>
	<s:Boolean x:Key="/Default/Environment/SettingsMigration/IsMigratorApplied/=JetBrains_002EReSharper_002EPsi_002ECSharp_002ECodeStyle_002ECSharpPlaceEmbeddedOnSameLineMigration/@EntryIndexedValue">True</s:Boolean>
	<s:Boolean x:Key="/Default/Environment/SettingsMigration/IsMigratorApplied/=JetBrains_002EReSharper_002EPsi_002ECSharp_002ECodeStyle_002ECSharpUseContinuousIndentInsideBracesMigration/@EntryIndexedValue">True</s:Boolean>
	<s:Boolean x:Key="/Default/Environment/SettingsMigration/IsMigratorApplied/=JetBrains_002EReSharper_002EPsi_002ECSharp_002ECodeStyle_002ESettingsUpgrade_002EMigrateBlankLinesAroundFieldToBlankLinesAroundProperty/@EntryIndexedValue">True</s:Boolean>
</wpf:ResourceDictionary>
