<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <!-- NU1702: the three net48 fixture references below. MSBuild negotiates a target framework per
             ProjectReference and warns that net48 was resolved for this net10.0 consumer — which is the
             whole arrangement, and harmless, because ReferenceOutputAssembly=false means nothing from
             them is ever compiled against. Suppressed at project level because per-item NoWarn does not
             reach this warning and SkipGetTargetFrameworkProperties, which does, also stops the resolved
             output paths reaching the baked metadata attributes the tests read. -->
        <NoWarn>$(NoWarn);xUnit1051;NU1702</NoWarn>
        <!-- RestorePackagesWithLockFile inline here (rather than a tests/Directory.Build.props) so it
             applies to this project alone. A directory-level policy would also catch the
             deliberately-unlocked fixtures below it: the spec-fixture projects under tests/Fixtures/
             (slnx members, so a CI solution restore would demand lock files for them) and the MyApp
             fixture solution under this project's Fixtures/TestSolutions/, whose bin-output copies
             FixtureRestorer restores mid-test-run with $(CI) still set. RestoreLockedMode below needs no
             such scoping — every tracked csproj carries it, and without a lock file beside it there is
             nothing for it to hold. -->
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    </PropertyGroup>

    <!-- Analyzer severities from the repo-root analyzers.globalconfig, named here for the same reason the
         lock policy above is inline: this project alone, never the fixture solutions below it.
         src/Directory.Build.props names the same file for the shipping projects. -->
    <ItemGroup>
        <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)../../analyzers.globalconfig" />
    </ItemGroup>

    <!-- Microsoft.Testing.Platform, not VSTest. xunit.v3 4.0.0 ships MTP 2.x, which the .NET 10 SDK
         declines to drive through the VSTest target, so the version bump forces a change of runner. The
         VSTest-era packages that used to sit here have no path left to execute on and are gone rather than
         dormant: Microsoft.NET.Test.Sdk, xunit.runner.visualstudio (the VSTest adapter, and nothing else),
         and coverlet.collector, which is a VSTest data collector. Coverage moves to the extension below,
         which still writes Cobertura, so only the request changes and everything downstream that reads the
         XML is unaffected. global.json at the repo root names the runner. -->
    <ItemGroup>
        <!-- FsCheck.Xunit.v3, not FsCheck.Xunit: the plain package pins xunit.extensibility.execution below
             3.0.0 — xunit v2 — so it cannot restore beside the xunit.v3 below. The .v3 variant pins
             xunit.v3.extensibility.core [4.0.0, 5.0.0) and still puts [Property] in the FsCheck.Xunit
             namespace. FsCheck itself is explicit rather than transitive so Dependabot tracks the version the
             one property suite (Internal/WildcardPropertyTests) is written against. -->
        <PackageReference Include="FsCheck" Version="3.4.0" />
        <PackageReference Include="FsCheck.Xunit.v3" Version="3.4.0" />
        <!-- The DI/Hosting abstractions the registration-recognition tests (CompilationFactory's DiReferences)
             bind against — promoted from transitive (via the MCP/Hosting stack) to explicit, so the versions
             the recognizer resolves are pinned here rather than floating on another package's closure. -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
        <!-- The completion surface the spec-completion tests drive the provider through, at the version
             this test host resolves rather than the 4.0.1 floor the provider is built against: a provider
             has to answer the editor of the day, and running it against the floor would be testing the
             one host nobody uses. It composes the same parts an editor composes, so the host services
             every workspace in this suite creates gain them too. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
        <PackageReference Include="Shouldly" Version="4.3.0" />
        <!-- Differential-testing oracle: the ArchUnitNET core builds a rival architecture
             model from compiled MyApp IL (Mono.Cecil), cross-checking SlideRule's Roslyn-source model. -->
        <PackageReference Include="TngTech.ArchUnitNET" Version="0.13.4" />
        <PackageReference Include="xunit.v3" Version="4.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SlideRule\SlideRule.csproj" />
        <!-- An ordinary assembly reference, deliberately not an Analyzer item: the tests drive the build-tier
             analyzer in-process through CompilationWithAnalyzers over compilations they build themselves, and
             an Analyzer item would instead run it over this project's own build. -->
        <ProjectReference Include="..\..\src\SlideRule.Analyzers\SlideRule.Analyzers.csproj" />
        <ProjectReference Include="..\..\src\SlideRule.Cli\SlideRule.Cli.csproj" />
        <ProjectReference Include="..\..\src\SlideRule.Extraction\SlideRule.Extraction.csproj" />
        <ProjectReference Include="..\..\src\SlideRule.Roslyn\SlideRule.Roslyn.csproj" />
        <!-- An ordinary assembly reference for the same reason the build-tier analyzer's is one: the tests
             drive the spec-literal analyzer in-process through CompilationWithAnalyzers over compilations
             they build themselves, and an Analyzer item would instead run it over this project's own
             build, where there is no spec to read. -->
        <ProjectReference Include="..\..\src\SlideRule.SpecAnalyzers\SlideRule.SpecAnalyzers.csproj" />
        <!-- An ordinary assembly reference, and for the opposite reason to the two analyzers': a
             completion provider is not an Analyzer item in the first place. The tests hand the assembly
             to a workspace's host services and drive the provider through a completion service over
             documents they build themselves, which is what an editor does with it. -->
        <ProjectReference Include="..\..\src\SlideRule.SpecCompletion\SlideRule.SpecCompletion.csproj" />
        <ProjectReference Include="..\..\src\SlideRule.Xunit\SlideRule.Xunit.csproj" />
        <!-- The rule pack, so its nine rules can be pinned against the hand-written equivalents. It
             brings Microsoft.Extensions.DependencyInjection (the container, not just the abstractions)
             in transitively — hence the lock-file churn that lands with this reference. -->
        <ProjectReference Include="..\..\src\SlideRule.Packs.DotNet\SlideRule.Packs.DotNet.csproj" />
        <!-- Normal reference (ReferenceOutputAssembly=true): AgentsMd_IsCurrent consumes the dogfood
             spec type directly to compose the block in-process. Unlike the fixture specs, using this
             type is legitimate. -->
        <ProjectReference Include="..\..\arch\SlideRule.Architecture\SlideRule.Architecture.csproj" />
    </ItemGroup>

    <!-- Spec fixtures are referenced for build order only: ReferenceOutputAssembly=false keeps their
         types invisible to compilation (so tests cannot cheat by referencing them), and Private=false
         keeps their DLLs out of this project's output (the CLI/ALC loads them by path). Each gets a
         distinct OutputItemType so its resolved path can be baked as its own metadata attribute. -->
    <ItemGroup>
        <ProjectReference Include="..\Fixtures\SlideRule.SpecFixture\SlideRule.SpecFixture.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="SpecFixtureAssembly"
                          Private="false" />
        <ProjectReference Include="..\Fixtures\SlideRule.MyAppViolatedSpec\SlideRule.MyAppViolatedSpec.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="ViolatedSpecAssembly"
                          Private="false" />
        <ProjectReference Include="..\Fixtures\SlideRule.MyAppCleanSpec\SlideRule.MyAppCleanSpec.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="CleanSpecAssembly"
                          Private="false" />
        <ProjectReference Include="..\Fixtures\SlideRule.MyAppRenderSpec\SlideRule.MyAppRenderSpec.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="RenderSpecAssembly"
                          Private="false" />
        <ProjectReference Include="..\Fixtures\SlideRule.MyAppLayerSpec\SlideRule.MyAppLayerSpec.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="LayerSpecAssembly"
                          Private="false" />
        <ProjectReference Include="..\Fixtures\SlideRule.MyAppQuarantinedSpec\SlideRule.MyAppQuarantinedSpec.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="QuarantinedSpecAssembly"
                          Private="false" />
        <ProjectReference Include="..\Fixtures\SlideRule.MyAppDerivedSpec\SlideRule.MyAppDerivedSpec.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="DerivedSpecAssembly"
                          Private="false" />
        <!-- The spec for the polyglot bed: its one rule holds, so the check e2e can assert that a report
             which is genuinely clean still names the project the model never contained. -->
        <ProjectReference Include="..\Fixtures\SlideRule.PolyglotAppSpec\SlideRule.PolyglotAppSpec.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="PolyglotSpecAssembly"
                          Private="false" />
        <!-- The spec whose typeof() anchor lives in a .NET shared framework — the load failure no build
             setting can fix. Its own csproj explains why CopyLocalLockFileAssemblies is on there. -->
        <ProjectReference Include="..\Fixtures\SlideRule.SharedFrameworkSpec\SlideRule.SharedFrameworkSpec.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="SharedFrameworkSpecAssembly"
                          Private="false" />
        <!-- The net48 legacy trio, same discipline. LegacyProduct is the Framework product assembly the
             legacy spec typeof()s; the tests need its path to assert which load context resolved it.
             These are why NU1702 is suppressed above. -->
        <ProjectReference Include="..\Fixtures\SlideRule.LegacyProduct\SlideRule.LegacyProduct.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="LegacyProductAssembly"
                          Private="false" />
        <ProjectReference Include="..\Fixtures\SlideRule.LegacySpec\SlideRule.LegacySpec.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="LegacySpecAssembly"
                          Private="false" />
        <!-- The spec that cannot produce a model, driving ModelPipeline.LoadModel's failure arms end to
             end. Same net48 discipline as its sibling; the tests stage its output to withhold a dependency. -->
        <ProjectReference Include="..\Fixtures\SlideRule.LegacyBrokenSpec\SlideRule.LegacyBrokenSpec.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="LegacyBrokenSpecAssembly"
                          Private="false" />
        <ProjectReference Include="..\Fixtures\SlideRule.ClassicAppSpec\SlideRule.ClassicAppSpec.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="ClassicAppSpecAssembly"
                          Private="false" />
    </ItemGroup>

    <!-- The MyApp fixture solution's three projects, pulled into the build graph so their IL exists for
         the ArchUnitNET oracle. Same discipline as the spec fixtures above:
         ReferenceOutputAssembly=false keeps MyApp types invisible to compilation (the tests can't see
         them by CLR identity — the oracle stub stands in), and Private=false keeps their DLLs out of the
         tests output copy (the oracle loads them by baked path). Each carries a distinct OutputItemType so
         its resolved DLL path is baked as its own metadata attribute. -->
    <ItemGroup>
        <ProjectReference Include="Fixtures\TestSolutions\MyApp\MyApp.Domain\MyApp.Domain.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="MyAppDomainAssembly"
                          Private="false" />
        <ProjectReference Include="Fixtures\TestSolutions\MyApp\MyApp.Web\MyApp.Web.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="MyAppWebAssembly"
                          Private="false" />
        <ProjectReference Include="Fixtures\TestSolutions\MyApp\MyApp.Legacy.Billing\MyApp.Legacy.Billing.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="MyAppBillingAssembly"
                          Private="false" />
    </ItemGroup>

    <!-- Bake each built fixture DLL's absolute path into an assembly metadata attribute the tests
         read at runtime. Runs after references resolve and before assembly info is generated, so the
         paths are available and materialized into the compiled metadata. -->
    <Target Name="AddSpecFixturePathAttribute"
            BeforeTargets="CoreGenerateAssemblyInfo"
            DependsOnTargets="ResolveProjectReferences">
        <ItemGroup>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>SpecFixturePath</_Parameter1>
                <_Parameter2>@(SpecFixtureAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>ViolatedSpecPath</_Parameter1>
                <_Parameter2>@(ViolatedSpecAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>CleanSpecPath</_Parameter1>
                <_Parameter2>@(CleanSpecAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>RenderSpecPath</_Parameter1>
                <_Parameter2>@(RenderSpecAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>LayerSpecPath</_Parameter1>
                <_Parameter2>@(LayerSpecAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>QuarantinedSpecPath</_Parameter1>
                <_Parameter2>@(QuarantinedSpecAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>DerivedSpecPath</_Parameter1>
                <_Parameter2>@(DerivedSpecAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>PolyglotSpecPath</_Parameter1>
                <_Parameter2>@(PolyglotSpecAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>SharedFrameworkSpecPath</_Parameter1>
                <_Parameter2>@(SharedFrameworkSpecAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <!-- The net48 legacy trio's DLL paths. -->
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>LegacyProductPath</_Parameter1>
                <_Parameter2>@(LegacyProductAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>LegacySpecPath</_Parameter1>
                <_Parameter2>@(LegacySpecAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>LegacyBrokenSpecPath</_Parameter1>
                <_Parameter2>@(LegacyBrokenSpecAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>ClassicAppSpecPath</_Parameter1>
                <_Parameter2>@(ClassicAppSpecAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <!-- The three MyApp fixture DLL paths, for the ArchUnitNET oracle to load by path. -->
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>MyAppDomainPath</_Parameter1>
                <_Parameter2>@(MyAppDomainAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>MyAppWebPath</_Parameter1>
                <_Parameter2>@(MyAppWebAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>MyAppBillingPath</_Parameter1>
                <_Parameter2>@(MyAppBillingAssembly->'%(FullPath)')</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <!-- Test fixtures (e.g. the fixture solutions) are copied to output, not compiled.
         An empty Fixtures glob is not an error, so this stays safe while no fixtures exist.
         This glob is the ONLY thing that carries Fixtures/LegacySolutions/ClassicApp into the output:
         it is a non-SDK .NET Framework project that cannot build on the ubuntu and macos CI legs, so it
         is never a solution member and never a ProjectReference. Its csproj comment has the full reason,
         including why it sits under LegacySolutions/ rather than TestSolutions/. -->
    <ItemGroup>
        <Compile Remove="Fixtures/**/*.cs" />
        <Content Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
        <!-- A locally built/restored fixture must not leak build artifacts into the output copy: a
             stale swept-in project.assets.json would defeat FixtureRestorer's restore-skip check. -->
        <Content Remove="Fixtures/**/bin/**" />
        <Content Remove="Fixtures/**/obj/**" />
        <!-- Nor a lock file. Every fixture csproj declares RestoreLockedMode under $(CI), since Scorecard
             reads csproj files only, and the property is inert only because no packages.lock.json sits
             beside it. A hand-run restore asking for a lock file is the one way one could appear; swept into bin/ it would reach the copies
             FixtureRestorer restores mid-test-run with $(CI) still set, and turn that inert property live
             against a graph nobody committed. -->
        <Content Remove="Fixtures/**/packages.lock.json" />
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Cli/Golden/*.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Cli/Golden/*.sarif" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Cli/Golden/*.md" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
