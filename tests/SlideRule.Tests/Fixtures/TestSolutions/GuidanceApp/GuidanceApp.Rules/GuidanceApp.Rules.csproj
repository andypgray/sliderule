<Project Sdk="Microsoft.NET.Sdk">
    <!-- The guidance analyzer's bed: one project breaking each of the package's rules once beside a near miss
         of each, and one touching every anchor the conforming way. The package reference is the one the
         rules' anchors need. NuGetAudit is off for MyApp.Web's reason: an unreachable feed's advisory fetch
         would surface as a workspace diagnostic. Restored UNLOCKED, as every bed is. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NuGetAudit>false</NuGetAudit>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    </ItemGroup>
</Project>
