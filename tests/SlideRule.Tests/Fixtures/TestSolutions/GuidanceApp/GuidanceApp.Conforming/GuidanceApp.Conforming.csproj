<Project Sdk="Microsoft.NET.Sdk">
    <!-- The guidance analyzer's conforming project: it touches every anchor the conforming way, so the build
         reports nothing at the shipped severities. GuidanceApp.Rules.csproj says why the bed exists and what
         its settings are for. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NuGetAudit>false</NuGetAudit>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    </ItemGroup>
</Project>
