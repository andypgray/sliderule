<?xml version="1.0" encoding="utf-8"?>
<!--
  The bed's only package source. <clear/> drops nuget.org and every machine-level source, so Contoso.Shims can
  come from nowhere but the folder feed the test writes at the root of its copy. A relative value resolves
  against this file's own directory.
-->
<configuration>
    <packageSources>
        <clear />
        <add key="source-only-local" value="../../../feed" />
    </packageSources>
</configuration>
