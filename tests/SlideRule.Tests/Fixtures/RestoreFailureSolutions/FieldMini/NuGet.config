<?xml version="1.0" encoding="utf-8"?>
<!--
  The good arm's feed. <clear/> is what makes the bed hermetic: nuget.org and every machine-level source
  are dropped, so the only place Contoso.Json can come from is the ./feed directory the test writes it
  into. The path is relative to this file, which NuGet resolves against the config's own directory.

  The broken arm overwrites this file in its private copy with an unreachable source and re-restores. The
  tree is otherwise untouched between the two arms — no edit, no rebuild — so the feed is the only
  variable, which is what makes the exit-code difference attributable to the restore and nothing else.
-->
<configuration>
    <packageSources>
        <clear />
        <add key="field-mini-local" value="feed" />
    </packageSources>
</configuration>
