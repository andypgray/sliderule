{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SlideRule",
          "version": "0.2.0",
          "informationUri": "https://github.com/andypgray/sliderule",
          "rules": [
            {
              "id": "layering/domain-independent",
              "shortDescription": {
                "text": "The Domain layer must not reference the Web layer."
              },
              "fullDescription": {
                "text": "Domain is UI-agnostic; transaction boundaries live in services."
              },
              "help": {
                "text": "Define an abstraction in Domain and implement it in Web."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "layering/projects-independent",
              "shortDescription": {
                "text": "Each of the projects matching `MyApp.*` must not reference the others."
              },
              "fullDescription": {
                "text": "Each MyApp project is its own deployable unit; a reference from one into another couples their release cadences."
              },
              "help": {
                "text": "Move the shared type into a project both may reference, or reach the other project through an abstraction it owns."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "layering/projects-reached-only-by-themselves",
              "shortDescription": {
                "text": "Each of the projects matching `MyApp.*` must be referenced only by itself."
              },
              "fullDescription": {
                "text": "A project anything may reach into has no surface to change; every edge into it is part of its contract whether or not anyone meant it to be."
              },
              "help": {
                "text": "Reach the project through an abstraction it owns, or move the type both projects need into a project both may reference."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "migrate"
              }
            },
            {
              "id": "layering/web-cuts-not-circular",
              "shortDescription": {
                "text": "Each of the Reporting and Invoicing layers must not have circular references with the others."
              },
              "fullDescription": {
                "text": "Reporting and invoicing are two cuts of the web layer with no intended order between them; a circle means neither can be extracted without dragging the other along."
              },
              "help": {
                "text": "Move what one cut borrows from the other into a type both may reach, or pick a direction and state it as an ordering rule."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "layering/billing-independent",
              "shortDescription": {
                "text": "Types in `MyApp.Legacy.Billing.*` must not reference types in `MyApp.Web.*`."
              },
              "fullDescription": {
                "text": "Billing must not reach up into the web layer."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "data-access/no-inline-sql",
              "shortDescription": {
                "text": "Types in the Web layer named `*Controller` must not reference types in `System.Data.*`."
              },
              "fullDescription": {
                "text": "Repository pattern for testability."
              },
              "help": {
                "text": "Inject the repository."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "migrate"
              }
            },
            {
              "id": "time/inject-clock",
              "shortDescription": {
                "text": "The Web layer must not use `DateTime.Now` or `DateTime.UtcNow`."
              },
              "fullDescription": {
                "text": "Wall-clock reads are untestable; inject IClock."
              },
              "help": {
                "text": "Take IClock in the constructor. Exemplar: OrderService (MyApp.Domain/OrderService.cs:5)."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "migrate"
              }
            },
            {
              "id": "naming/async-suffix",
              "shortDescription": {
                "text": "Methods returning `Task` or `Task<TResult>` declared in the Web layer must be named `*Async`."
              },
              "fullDescription": {
                "text": "Async methods are discovered by their Async suffix."
              },
              "help": {
                "text": "Rename the method to end in Async and update its callers."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "migrate"
              }
            },
            {
              "id": "di/handlers-via-registry",
              "shortDescription": {
                "text": "Types, except `HandlerRegistry`, must not construct types implementing `IHandler<T>`."
              },
              "fullDescription": {
                "text": "Handlers are resolved through HandlerRegistry; direct construction bypasses discovery."
              },
              "help": {
                "text": "Resolve the handler through HandlerRegistry instead of constructing it."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "migrate"
              }
            },
            {
              "id": "di/no-captive-dependencies",
              "shortDescription": {
                "text": "Singleton-registered types must not inject scoped-registered types or transient-registered types."
              },
              "fullDescription": {
                "text": "A singleton that captures a scoped or transient service pins it to the whole process lifetime."
              },
              "help": {
                "text": "Inject IServiceScopeFactory and resolve the dependency inside a scope."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "migrate"
              }
            },
            {
              "id": "layering/no-ghost",
              "shortDescription": {
                "text": "Types in `MyApp.Domain.*` must not reference types in `MyApp.Ghost.*`."
              },
              "fullDescription": {
                "text": "Nothing should reference the (nonexistent) ghost layer."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "naming/nonexistent",
              "shortDescription": {
                "text": "Types in `MyApp.Nowhere.*` must be named `*Service`."
              },
              "fullDescription": {
                "text": "A subject that matches nothing must fail loudly."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "legacy/billing/containment",
              "shortDescription": {
                "text": "Types in `MyApp.Legacy.Billing.*`, except `IBillingFacade` or `BillingFacade`, must be referenced only by types in `MyApp.Legacy.Billing.*`, `IBillingFacade` or `BillingFacade`."
              },
              "fullDescription": {
                "text": "Replacement scheduled; not worth stabilizing."
              },
              "help": {
                "text": "use `IBillingFacade`"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "quarantine"
              }
            },
            {
              "id": "legacy/billing/tripwire",
              "fullDescription": {
                "text": "Replacement scheduled; not worth stabilizing."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "posture": "quarantine"
              }
            },
            {
              "id": "exceptions/no-general-catch",
              "shortDescription": {
                "text": "The Web layer must not catch `Exception`."
              },
              "fullDescription": {
                "text": "A catch-all hides the failures you meant to handle; catch the specific exception instead."
              },
              "help": {
                "text": "Catch the specific exception type you can handle, not System.Exception."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "migrate"
              }
            },
            {
              "id": "exceptions/domain-throws-domain",
              "shortDescription": {
                "text": "The Domain layer must throw only `OrderRuleViolation`."
              },
              "fullDescription": {
                "text": "Domain code signals rule failures with the domain's own exception, not a generic BCL type."
              },
              "help": {
                "text": "Throw OrderRuleViolation (or another domain exception) instead of a BCL exception type."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "async/accept-cancellation",
              "shortDescription": {
                "text": "Methods returning `Task` or `Task<TResult>` declared in the Web layer must accept a parameter of type `CancellationToken`."
              },
              "fullDescription": {
                "text": "A Task-returning method that ignores cancellation cannot be stopped once its caller has moved on."
              },
              "help": {
                "text": "Add a CancellationToken parameter and flow it to the calls you await."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "api/return-dtos",
              "shortDescription": {
                "text": "The Web layer must not expose `DataTable`."
              },
              "fullDescription": {
                "text": "An infrastructure type on a presentation-layer public signature couples every caller to it; return a DTO or view model."
              },
              "help": {
                "text": "Return a DTO instead of exposing System.Data.DataTable."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "migrate"
              }
            },
            {
              "id": "exceptions/no-unfiltered-catch",
              "shortDescription": {
                "text": "The Web or Domain layers must not catch `Exception` without a `when` filter."
              },
              "fullDescription": {
                "text": "An unfiltered broad catch swallows every failure alike; a `when` filter names the ones this handler actually expects."
              },
              "help": {
                "text": "Add a `when` filter naming the exceptions you can handle, or catch those types directly."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "exceptions/no-swallowed-catch",
              "shortDescription": {
                "text": "The Web or Domain layers must not swallow `Exception`."
              },
              "fullDescription": {
                "text": "A handler that catches everything and continues hands its caller a wrong answer that reads like a right one; rethrowing keeps the failure travelling."
              },
              "help": {
                "text": "Rethrow after cleanup, translate to a domain exception, or add a `when` filter naming what you can handle."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "exceptions/no-bare-bcl-throw",
              "shortDescription": {
                "text": "The Domain layer must not throw `InvalidOperationException`."
              },
              "fullDescription": {
                "text": "InvalidOperationException tells a caller nothing it can dispatch on; the domain has its own exception for rule failures."
              },
              "help": {
                "text": "Throw OrderRuleViolation instead of System.InvalidOperationException."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "layering/services-in-web",
              "shortDescription": {
                "text": "Types named `*Service` must reside in project `MyApp.Web`."
              },
              "fullDescription": {
                "text": "Services are wired by the web host; a service outside MyApp.Web escapes its registration sweep."
              },
              "help": {
                "text": "Move the service into the MyApp.Web project."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "layering/services-behind-contracts",
              "shortDescription": {
                "text": "Types named `*Service` must have exactly one counterpart named `I{Name}` among interfaces."
              },
              "fullDescription": {
                "text": "A caller that can only name the concrete service cannot be handed a different one; the I{Name} contract is where a double or a second implementation goes."
              },
              "help": {
                "text": "Extract an I{Name} interface for the service and consume that."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "migrate"
              }
            },
            {
              "id": "layering/no-ungoverned-types",
              "shortDescription": {
                "text": "Types in `MyApp.*` must belong to the Domain layer or the Web layer."
              },
              "fullDescription": {
                "text": "A type in no declared layer is governed by no layer rule; the two layers are the covering set."
              },
              "help": {
                "text": "Move the type into a declared layer's namespace, or declare its layer in this spec."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "di/handlers-registered",
              "shortDescription": {
                "text": "Types implementing `IHandler<T>` or types named `*Scheduler` must be registered."
              },
              "fullDescription": {
                "text": "Handlers and schedulers are resolved from the container; one that is never registered fails at dispatch, not at startup."
              },
              "help": {
                "text": "Register the type in ServiceWiring.Configure."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "domain/values-immutable",
              "shortDescription": {
                "text": "Properties of the Domain layer must be get-only."
              },
              "fullDescription": {
                "text": "A value a caller can reassign after construction is not a value; the invariants the constructor checked stop holding the moment anyone writes to it."
              },
              "help": {
                "text": "Take the value in the constructor and expose it `{ get; }`; hand back a new instance for a changed one."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "state/no-static-mutable",
              "shortDescription": {
                "text": "Static fields of the Web layer must be readonly."
              },
              "fullDescription": {
                "text": "A writable static is state the whole process shares; the last write anywhere decides what the next request reads, and nothing in the signature says so."
              },
              "help": {
                "text": "Make the field `readonly` or `const`, or move the state onto an instance whose lifetime the caller controls."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "packaging/supported-frameworks",
              "shortDescription": {
                "text": "Projects matching `MyApp.*` must target only `net8.0`."
              },
              "fullDescription": {
                "text": "The hosts this app deploys to are on the net8.0 LTS; a project that targets anything newer builds here and fails to start there."
              },
              "help": {
                "text": "Set `TargetFramework` to `net8.0`, or upgrade the hosts first and move this rule with them."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "packaging/no-feed-dependencies",
              "shortDescription": {
                "text": "Projects matching `MyApp.*` must reference no NuGet packages other than private ones, whose `PrivateAssets` is `all` (declared references only; transitive dependencies are not seen)."
              },
              "fullDescription": {
                "text": "Other solutions take these projects as packages; a package one of them depends on becomes a dependency of every solution that takes it."
              },
              "help": {
                "text": "Use a type the SDK already supplies, or reference an assembly the repository carries."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "packaging/locked-restore",
              "shortDescription": {
                "text": "Project `MyApp.Web` must lock package restore."
              },
              "fullDescription": {
                "text": "An unpinned restore resolves a different package graph on a different day; the build CI passed is then not the build that ships."
              },
              "help": {
                "text": "Set `RestorePackagesWithLockFile` to true and commit the lock file the next restore produces."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "packaging/nothing-published",
              "shortDescription": {
                "text": "Projects matching `MyApp.*`, except project `MyApp.Legacy.Billing`, must not be packable."
              },
              "fullDescription": {
                "text": "The SDK packs by default, so a project nobody meant to publish is one `dotnet pack` away from a package on a feed."
              },
              "help": {
                "text": "Set `IsPackable` to false in the project file."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "posture": "enforce"
              }
            },
            {
              "id": "domain/retry-budget/tripwire",
              "fullDescription": {
                "text": "The retry budget is the one place the domain sanctions a broad catch, and every caller relies on the filter."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "posture": "caution"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "originalUriBaseIds": {
        "SRCROOT": {}
      },
