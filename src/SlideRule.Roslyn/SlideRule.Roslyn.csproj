<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net10.0: this is the machinery half of the Core(model, netstandard2.0)/Roslyn split.
             It hosts MSBuildWorkspace + the extractor and never enters Core's dependency closure. -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Carried inside the packages that run it rather than shipped as one of its own: nothing here is
             public, and the tool and the xUnit adapter bundle this assembly beside their own. -->
        <IsPackable>false</IsPackable>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SlideRule\SlideRule.csproj" />
        <ProjectReference Include="..\SlideRule.Extraction\SlideRule.Extraction.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- 'sliderule' is the CLI's AssemblyName; the adapter reaches the baseline store + the host
             UserErrorException. Both consume this project's internal host layer (BaselineStore). -->
        <InternalsVisibleTo Include="sliderule-cli" />
        <InternalsVisibleTo Include="SlideRule.Xunit" />
        <InternalsVisibleTo Include="SlideRule.Tests" />
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>

    <!-- Severities for this project alone, beside the repo-wide file src/Directory.Build.props names. The
         file explains what it promotes and why the CLI is held to less. -->
    <ItemGroup>
        <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)library.globalconfig" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    </ItemGroup>

    <!-- Basic.CompilerLog.Util (jaredpar/complog, MIT) powers binlog replay: a real
         build's binlog is read into a workspace-shaped Solution without a design-time build (no
         MSBuildWorkspace, no build host). Exact-pinned. Its net10.0 group floors
         Microsoft.CodeAnalysis(.CSharp) at >= 4.8.0, which unifies under the 5.9.0 Workspaces pins above.
         The MSBuild.StructuredLogger it pulls is a binlog *parser*, not the MSBuild engine — but it still
         BINDS engine assemblies (Microsoft.Build.Framework) at runtime, resolved through MSBuildLocator
         registration, which the CLI's replay path performs up front. No engine assemblies ship (see the
         ExcludeAssets="runtime" block below); the SDK's are resolved on the host after registration. -->
    <ItemGroup>
        <PackageReference Include="Basic.CompilerLog.Util" Version="0.9.65" />
    </ItemGroup>

    <!-- complog references the Microsoft.CodeAnalysis meta-package at >= 4.8.0; left alone it resolves
         to 4.8.0, whose exact-version constraints on its C#/VB workspace children (= 4.8.0) collide with
         our 5.9.0 workspace pins and raise NU1608. Pin the meta-package to 5.9.0 so the whole graph —
         C#, VB, and their Common/Workspaces cores — unifies at 5.9.0 (the repo's zero-warnings culture).
         The VB assemblies ride along (complog pulls them regardless); replay filters to C# projects. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
    </ItemGroup>

    <!-- MSBuild.Locator requires that MSBuild runtime assemblies are NOT shipped with the app; they
         are loaded at runtime by MSBuildLocator.RegisterDefaults(). ExcludeAssets="runtime" keeps the
         engine DLLs out of the build output, and PrivateAssets="all" keeps these off the published
         nuspec — a consumer of this package (or of the tool that bundles it) must resolve MSBuild from
         the SDK on the host, never from us. The four Microsoft.Build engine packages and
         Microsoft.NET.StringTools — a leaf string-interning utility they depend on — are
         exact-pinned, in lockstep, on the MSBuild line that ships assets for this project's target
         framework: 18.9 for net10.0. Each MSBuild minor line now ships for its own .NET only, and 18.10
         carries net11.0 and net472 but no net10.0, so Microsoft.Build 18.10 would compile here against
         its .NET Framework assemblies. Dependabot moves these within the line and ignores the next
         one; the hold lifts with the move to net11.0. Being compile-only, the version is not a host
         requirement: the host's MSBuild binds at run time, and the code touches only the Locator and
         the long-stable Construction, Definition and Evaluation API.
         Exact versions rather than floating "*", because a lock file cannot capture a wildcard and
         supply-chain locking demands a determinate version. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Build" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.NET.StringTools" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>

    <!-- Override vulnerable transitive pulled in by Microsoft.Build.Tasks.Core (NU1903). -->
    <ItemGroup>
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>

</Project>
