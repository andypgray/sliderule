{
  "schemaVersion": 2,
  "spec": "SlideRule.Guidance.DotNet",
  "projects": [],
  "layers": [],
  "rules": [
    {
      "id": "http/reuse-httpclient",
      "posture": "enforce",
      "sentence": "Types, except types named `Program` or types named `*Startup`, must not construct `HttpClient`.",
      "because": "A new HttpClient per call exhausts sockets under load; IHttpClientFactory pools handlers.",
      "fix": "Take a typed or named client from IHttpClientFactory rather than constructing one.",
      "citation": "https://learn.microsoft.com/dotnet/fundamentals/networking/http/httpclient-guidelines",
      "constraint": { "node": "mustNotConstruct", "subject": { "noun": { "node": "types" }, "adjectives": [{ "node": "except", "payload": { "union": [{ "noun": { "node": "types" }, "adjectives": [{ "node": "named", "names": ["Program"] }] }, { "noun": { "node": "types" }, "adjectives": [{ "node": "withSuffix", "suffix": "Startup" }] }] } }] }, "operands": [{ "noun": { "node": "type", "anchor": { "name": "System.Net.Http.HttpClient" } } }] }
    },
    {
      "id": "di/no-service-locator",
      "posture": "enforce",
      "sentence": "Types, except types named `Program` or types named `*Startup`, must not use `IServiceProvider.GetService()`, `ServiceProviderServiceExtensions.GetService()` or `ServiceProviderServiceExtensions.GetRequiredService()`.",
      "because": "Resolving services from IServiceProvider at call sites hides a type's real dependencies; declare them as constructor parameters.",
      "fix": "Take the dependency in the constructor; the composition root and its scope seam are the only sanctioned resolve sites.",
      "citation": "https://learn.microsoft.com/dotnet/core/extensions/dependency-injection/guidelines",
      "constraint": { "node": "mustNotUse", "subject": { "noun": { "node": "types" }, "adjectives": [{ "node": "except", "payload": { "union": [{ "noun": { "node": "types" }, "adjectives": [{ "node": "named", "names": ["Program"] }] }, { "noun": { "node": "types" }, "adjectives": [{ "node": "withSuffix", "suffix": "Startup" }] }] } }] }, "members": [{ "declaring": { "name": "System.IServiceProvider" }, "name": "GetService", "isMethod": true }, { "declaring": { "name": "Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions" }, "name": "GetService", "isMethod": true }, { "declaring": { "name": "Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions" }, "name": "GetRequiredService", "isMethod": true }] }
    },
    {
      "id": "di/no-buildserviceprovider",
      "posture": "enforce",
      "sentence": "Types must not use `ServiceCollectionContainerBuilderExtensions.BuildServiceProvider()`.",
      "because": "Calling BuildServiceProvider while configuring services builds a second container with its own singletons, a duplicate-instance trap.",
      "fix": "Register the dependency and let the host build the provider once; inject what you need.",
      "citation": "https://learn.microsoft.com/dotnet/core/extensions/dependency-injection/guidelines",
      "constraint": { "node": "mustNotUse", "subject": { "noun": { "node": "types" } }, "members": [{ "declaring": { "name": "Microsoft.Extensions.DependencyInjection.ServiceCollectionContainerBuilderExtensions" }, "name": "BuildServiceProvider", "isMethod": true }] }
    },
    {
      "id": "async/no-sync-over-async",
      "posture": "enforce",
      "sentence": "Types must not use `Task.Wait()`, `Task<TResult>.Result`, `ValueTask<TResult>.Result`, `TaskAwaiter.GetResult()`, `TaskAwaiter<TResult>.GetResult()`, `ValueTaskAwaiter.GetResult()` or `ValueTaskAwaiter<TResult>.GetResult()`.",
      "because": "Blocking on a Task or ValueTask (.Result/.Wait/.GetResult) ties up a thread and can deadlock in a captured context; await instead.",
      "fix": "Await the call and make the method async.",
      "citation": "https://learn.microsoft.com/dotnet/csharp/asynchronous-programming/async-scenarios",
      "constraint": { "node": "mustNotUse", "subject": { "noun": { "node": "types" } }, "members": [{ "declaring": { "name": "System.Threading.Tasks.Task" }, "name": "Wait", "isMethod": true }, { "declaring": { "name": "System.Threading.Tasks.Task<TResult>", "onDefinition": true }, "name": "Result", "isMethod": false }, { "declaring": { "name": "System.Threading.Tasks.ValueTask<TResult>", "onDefinition": true }, "name": "Result", "isMethod": false }, { "declaring": { "name": "System.Runtime.CompilerServices.TaskAwaiter" }, "name": "GetResult", "isMethod": true }, { "declaring": { "name": "System.Runtime.CompilerServices.TaskAwaiter<TResult>", "onDefinition": true }, "name": "GetResult", "isMethod": true }, { "declaring": { "name": "System.Runtime.CompilerServices.ValueTaskAwaiter" }, "name": "GetResult", "isMethod": true }, { "declaring": { "name": "System.Runtime.CompilerServices.ValueTaskAwaiter<TResult>", "onDefinition": true }, "name": "GetResult", "isMethod": true }] }
    },
    {
      "id": "naming/async-suffix",
      "posture": "enforce",
      "sentence": "Methods returning `Task`, `Task<TResult>`, `ValueTask` or `ValueTask<TResult>` declared in authored types, except `[Fact]`-attributed methods of types, `[Theory]`-attributed methods of types, `[Test]`-attributed methods of types, `[TestCase]`-attributed methods of types, `[TestCaseSource]`-attributed methods of types, `[SetUp]`-attributed methods of types, `[TearDown]`-attributed methods of types, `[OneTimeSetUp]`-attributed methods of types, `[OneTimeTearDown]`-attributed methods of types, `[TestMethod]`-attributed methods of types, `[DataTestMethod]`-attributed methods of types, `[TestInitialize]`-attributed methods of types, `[TestCleanup]`-attributed methods of types, public methods of types derived from `ControllerBase`, public methods of types derived from `Hub`, public methods of types derived from `Controller` or public methods of types derived from `ApiController`, must be named `*Async`.",
      "because": "Task- and ValueTask-returning methods carry the Async suffix so callers see at the call site that a method must be awaited.",
      "fix": "Rename the method to end in Async.",
      "citation": "https://learn.microsoft.com/dotnet/standard/asynchronous-programming-patterns/task-based-asynchronous-pattern-tap",
      "constraint": { "node": "memberMustHaveSuffix", "memberSubject": { "source": { "noun": { "node": "types" }, "adjectives": [{ "node": "authored" }] }, "kind": "method", "adjectives": [{ "node": "returning", "anchors": [{ "name": "System.Threading.Tasks.Task" }, { "name": "System.Threading.Tasks.Task<TResult>", "onDefinition": true }, { "name": "System.Threading.Tasks.ValueTask" }, { "name": "System.Threading.Tasks.ValueTask<TResult>", "onDefinition": true }] }, { "node": "memberExcept", "payloads": [{ "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "Xunit.FactAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "Xunit.TheoryAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.TestAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.TestCaseAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.TestCaseSourceAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.SetUpAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.TearDownAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.OneTimeSetUpAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.OneTimeTearDownAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "Microsoft.VisualStudio.TestTools.UnitTesting.DataTestMethodAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "Microsoft.VisualStudio.TestTools.UnitTesting.TestInitializeAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "Microsoft.VisualStudio.TestTools.UnitTesting.TestCleanupAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" }, "adjectives": [{ "node": "derivedFrom", "anchor": { "name": "Microsoft.AspNetCore.Mvc.ControllerBase", "onDefinition": true } }] }, "kind": "method", "adjectives": [{ "node": "memberAccessibility", "accessibility": "public" }] }, { "source": { "noun": { "node": "types" }, "adjectives": [{ "node": "derivedFrom", "anchor": { "name": "Microsoft.AspNetCore.SignalR.Hub", "onDefinition": true } }] }, "kind": "method", "adjectives": [{ "node": "memberAccessibility", "accessibility": "public" }] }, { "source": { "noun": { "node": "types" }, "adjectives": [{ "node": "derivedFrom", "anchor": { "name": "System.Web.Mvc.Controller", "onDefinition": true } }] }, "kind": "method", "adjectives": [{ "node": "memberAccessibility", "accessibility": "public" }] }, { "source": { "noun": { "node": "types" }, "adjectives": [{ "node": "derivedFrom", "anchor": { "name": "System.Web.Http.ApiController", "onDefinition": true } }] }, "kind": "method", "adjectives": [{ "node": "memberAccessibility", "accessibility": "public" }] }] }] }, "suffix": "Async" }
    },
    {
      "id": "exceptions/no-general-catch",
      "posture": "enforce",
      "sentence": "Types, except types named `Program`, types named `*Startup` or types derived from `BackgroundService`, must not swallow `Exception`.",
      "because": "Catching base Exception outside a top-level handler swallows the faults you meant to see; scope the catch-all to that handler and let other code catch only the specific types it can handle.",
      "fix": "Catch the specific exception you can handle, filter with `when`, or rethrow after cleanup; leave the catch-all to the top-level handler.",
      "citation": "https://learn.microsoft.com/dotnet/standard/design-guidelines/using-standard-exception-types",
      "constraint": { "node": "mustNotSwallow", "subject": { "noun": { "node": "types" }, "adjectives": [{ "node": "except", "payload": { "union": [{ "noun": { "node": "types" }, "adjectives": [{ "node": "named", "names": ["Program"] }] }, { "noun": { "node": "types" }, "adjectives": [{ "node": "withSuffix", "suffix": "Startup" }] }, { "noun": { "node": "types" }, "adjectives": [{ "node": "derivedFrom", "anchor": { "name": "Microsoft.Extensions.Hosting.BackgroundService", "onDefinition": true } }] }] } }] }, "operands": [{ "noun": { "node": "type", "anchor": { "name": "System.Exception" } } }] }
    },
    {
      "id": "async/accept-cancellation",
      "posture": "enforce",
      "sentence": "Methods returning `Task`, `Task<TResult>`, `ValueTask` or `ValueTask<TResult>` declared in authored types, except `[Fact]`-attributed methods of types, `[Theory]`-attributed methods of types, `[Test]`-attributed methods of types, `[TestCase]`-attributed methods of types, `[TestCaseSource]`-attributed methods of types, `[SetUp]`-attributed methods of types, `[TearDown]`-attributed methods of types, `[OneTimeSetUp]`-attributed methods of types, `[OneTimeTearDown]`-attributed methods of types, `[TestMethod]`-attributed methods of types, `[DataTestMethod]`-attributed methods of types, `[TestInitialize]`-attributed methods of types or `[TestCleanup]`-attributed methods of types, must accept a parameter of type `CancellationToken`.",
      "because": "Accepting a CancellationToken lets a caller stop in-flight async work and flow that request on to the calls it makes, so a Task- or ValueTask-returning method without one cannot take part in cooperative cancellation.",
      "fix": "Add a CancellationToken parameter and flow the caller's token through the call chain.",
      "citation": "https://learn.microsoft.com/dotnet/standard/asynchronous-programming-patterns/task-based-asynchronous-pattern-tap",
      "constraint": { "node": "memberMustAcceptParameter", "memberSubject": { "source": { "noun": { "node": "types" }, "adjectives": [{ "node": "authored" }] }, "kind": "method", "adjectives": [{ "node": "returning", "anchors": [{ "name": "System.Threading.Tasks.Task" }, { "name": "System.Threading.Tasks.Task<TResult>", "onDefinition": true }, { "name": "System.Threading.Tasks.ValueTask" }, { "name": "System.Threading.Tasks.ValueTask<TResult>", "onDefinition": true }] }, { "node": "memberExcept", "payloads": [{ "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "Xunit.FactAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "Xunit.TheoryAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.TestAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.TestCaseAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.TestCaseSourceAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.SetUpAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.TearDownAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.OneTimeSetUpAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "NUnit.Framework.OneTimeTearDownAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "Microsoft.VisualStudio.TestTools.UnitTesting.DataTestMethodAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "Microsoft.VisualStudio.TestTools.UnitTesting.TestInitializeAttribute", "onDefinition": true } }] }, { "source": { "noun": { "node": "types" } }, "kind": "method", "adjectives": [{ "node": "memberAttributedWith", "anchor": { "name": "Microsoft.VisualStudio.TestTools.UnitTesting.TestCleanupAttribute", "onDefinition": true } }] }] }] }, "anchor": { "name": "System.Threading.CancellationToken" } }
    },
    {
      "id": "persistence/no-mapping-attributes",
      "posture": "enforce",
      "sentence": "Types must not be attributed with `[Table]` or `[ComplexType]`.",
      "because": "A persistence-specific attribute such as [Table] or [ComplexType] couples a persisted type to one data-access technology, so the same model can no longer be stored another way or moved to a new store; keep it ignorant of how it is persisted.",
      "fix": "Keep the persisted type a POCO and map it from the persistence layer with fluent configuration (EF Core's IEntityTypeConfiguration, a Dapper column list) instead of attributes on the type.",
      "citation": "https://learn.microsoft.com/dotnet/architecture/modern-web-apps-azure/architectural-principles",
      "constraint": { "node": "mustNotBeAttributedWith", "subject": { "noun": { "node": "types" } }, "anchors": [{ "name": "System.ComponentModel.DataAnnotations.Schema.TableAttribute" }, { "name": "System.ComponentModel.DataAnnotations.Schema.ComplexTypeAttribute" }] }
    }
  ],
  "omitted": []
}
