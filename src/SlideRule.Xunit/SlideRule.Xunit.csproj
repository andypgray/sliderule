<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The test-adapter surface: each post-desugar rule becomes an
             individually named xUnit test whose failure text matches the CLI human block. net10.0 host
             over Core (model) + Roslyn (workspace/extraction), the last two carried inside this package. -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- The xUnit adapter package. PackageId is explicit; version + shared metadata come from the
             repo-root Directory.Build.props. The &lt;TSpec&gt; in the description is XML-escaped. -->
        <PackageId>SlideRule.Xunit</PackageId>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>SlideRule.Xunit is the SlideRule xUnit adapter: every rule in an architecture spec runs as an individually named xUnit test. Derive a test class from ArchRuleTests&lt;TSpec&gt; and point it at the solution to check. A failing rule's message is the exact text the sliderule CLI prints. It requires xunit.v3 4.0.1 or later, which runs on Microsoft.Testing.Platform rather than VSTest. The test host also needs a .NET SDK, because the checker loads the target solution through MSBuildWorkspace.</Description>
        <PackageTags>architecture;architecture-as-code;xunit;testing;fitness-functions;dependency-rules;layering;csharp;dotnet</PackageTags>

        <!-- ApiCompat at pack time against the published package. This is the second of the two
             assemblies a consumer's own project compiles against, so it validates for the reason the
             Core csproj gives; the baseline version and strict mode come from src/Directory.Build.props,
             which says why the two packages share them. Every other package is a deliberate
             exemption, and PublicSurfaceSyncTests holds each one to the reason its own csproj states. -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>

        <!-- The hook pack runs for each framework's build output; the target at the bottom adds the two carried
             assemblies to it. -->
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_PackCarriedAssemblies</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
        <!-- Keeps MSBuild's engine out of the consumer's test output (the file says why). buildTransitive/ is where an
             SDK-style consumer reads it; a test project on xunit.v3 is always SDK-style, so build/ is not needed. -->
        <None Include="buildTransitive\SlideRule.Xunit.targets" Pack="true" PackagePath="buildTransitive/" />
    </ItemGroup>

    <ItemGroup>
        <!-- Core is the contract a consumer's spec project compiles against, so it stays a package dependency: the
             spec and the adapter have to load one copy of it. Roslyn, and Extraction behind it, publish no package of
             their own; they travel inside this one, so their reference is private and the target at the bottom puts
             both assemblies in lib/ beside the adapter. -->
        <ProjectReference Include="..\SlideRule\SlideRule.csproj" />
        <ProjectReference Include="..\SlideRule.Roslyn\SlideRule.Roslyn.csproj" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- The packages the Roslyn project passes on to whatever runs it, declared here because a private
             reference passes on nothing, and a consumer's test process could not open a workspace without them.
             Each is the version the Roslyn project pins, and AdapterCarriedPackagesTests holds the two lists
             equal. The compiler-API floor Extraction declares needs no line: the workspace packages here bring a
             newer compiler. The MSBuild workspace ships its build host as content files, which NuGet withholds
             from a package that arrives transitively, so that one reference keeps nothing private: without it a
             consumer's test output has no build host and no solution loads. -->
        <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" PrivateAssets="none" />
        <PackageReference Include="Basic.CompilerLog.Util" Version="0.9.64" />
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <!-- MSBuild's engine has to come from the SDK on the test host, through the Locator, never from this
             package's closure, or the Locator refuses the build (MSBL001). The workspace packages and complog's
             binlog reader each pull an older engine package whose assemblies would otherwise be copied beside the
             adapter, in this project and in every test project that takes the package. These three lines are the
             nearest declaration of each, compile-only, so they decide the version and keep the runtime assets out
             of this project's output. They are private, so the package does not carry them to a consumer's graph,
             where the engine packages still arrive through the packages that pull them: there the build file in
             buildTransitive/ removes the same runtime assets from the test project's output. The Roslyn project
             pins the same three, privately, for its own build. -->
        <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.NET.StringTools" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- The library-authoring pair (extensibility + assert), not the xunit.v3 metapackage — a test
             library references these, its consumers keep the metapackage. Since 4.0.0 that is the whole
             consumer side: the runner ships inside the metapackage as Microsoft.Testing.Platform, so
             there is no separate runner package to name. The pair's version is also the oldest xunit.v3
             a consumer can use: the metapackage pins both exactly, so a test project on an older one
             restores a mix of the two versions with NU1608 warnings. Raising it raises the requirement
             the description above and README.md state, and XunitRequirementSyncTests holds all three
             to one version. -->
        <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.2" />
        <PackageReference Include="xunit.v3.assert" Version="4.0.1" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SlideRule.Tests" />
    </ItemGroup>

    <!-- The carried assemblies go into lib/ beside the adapter's own, where the consumer's test output picks them
         up; nothing in them is public, so they add nothing a consumer can compile against. $(TargetDir) rather
         than $(OutputPath) because pack runs this for each framework's inner build, where only the former is the
         directory the build wrote. -->
    <Target Name="_PackCarriedAssemblies">
        <ItemGroup>
            <BuildOutputInPackage Include="$(TargetDir)SlideRule.Roslyn.dll;$(TargetDir)SlideRule.Extraction.dll" />
        </ItemGroup>
    </Target>

</Project>
