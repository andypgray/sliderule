<Project>

    <!-- Strong naming, imported by name from src/Directory.Build.props and the tests csproj. Nothing
         auto-discovers this file, so the fixture solutions staged under the tree stay unsigned; an unsigned
         project may reference a signed one.

         The key is part of every published assembly's identity: a .NET Framework project binds a reference by
         name, version and public key token. Never change the key and never remove it, since either is a break
         for every consumer compiled against a published package. The private key is committed because a
         strong name is an identity, not a security boundary, and committing it lets any clone build the
         same identity.

         PublicKey also keys every InternalsVisibleTo item that carries no Key of its own, which is how the
         SDK writes the grants between this repository's assemblies; a grant to an assembly signed with
         another key names that key, as the DynamicProxyGenAssembly2 grants do with Castle's. -->
    <PropertyGroup>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)SlideRule.snk</AssemblyOriginatorKeyFile>
        <PublicKey></PublicKey>
        <CastleDynamicProxyPublicKey></CastleDynamicProxyPublicKey>
    </PropertyGroup>

</Project>
